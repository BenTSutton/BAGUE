      percentageOdds: 0
      crewName: 
      flagId: 
    - effectType: 13
      amount: 20
      secondAmount: 0
      thirdAmount: 0
      percentageOdds: 0
      crewName: 
      flagId: 
    requirements: []
  - choiceText: Free the ship
    outcomeText: The tiny ship passes through yours, sealing torn hull plates as
      it goes.
